# Copy to .env and fill in. Never commit a real .env.
PORT=3000
# SQLite file path; use :memory: for throwaway runs
DB_PATH=./data/sentineldesk.db

# REQUIRED. The server refuses to start without it. At least 32 random characters.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional
# JWT_EXPIRES_IN=1h
# BCRYPT_ROUNDS=10

# Browsers: exact origins allowed to call the API, comma separated. Leave empty for none.
# "*" is refused on purpose. Example: CORS_ORIGINS=https://app.example.com,http://localhost:5173
# CORS_ORIGINS=

# Rate limit for login (failed attempts) and sign-up (all attempts), per IP
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# Set to 1 when hosted behind a reverse proxy (Render, Fly.io, Railway ...), so client IPs are correct
# TRUST_PROXY=0
