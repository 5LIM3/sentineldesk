# Copy to .env and fill in. Never commit a real .env.
PORT=3000
# SQLite file path; use :memory: for throwaway runs
DB_PATH=./data/sentineldesk.db

# REQUIRED. The server refuses to start without it. At least 32 random characters.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional
# JWT_EXPIRES_IN=1h
# BCRYPT_ROUNDS=10
